# 环境变量示例 —— 复制为 .env.local 后按需填写
# .env.local 已被 .gitignore 的 *.local 忽略，禁止把真值写进本文件或 .env.development

# ── 开发/联调：免验证码登录密钥 ──
# 取值必须与后端运行实例的 CAPTCHA_SKIP_SECRET 完全一致，失配时后端仍要求验证码。
# 仅开发/联调环境需要；生产构建不设该变量。
VITE_CAPTCHA_SKIP_SECRET=

# ── E2E 测试账号密码 ──
# Playwright 读取的是 **进程环境变量**（不读 .env 文件）。
# PowerShell: $env:VITE_E2E_PASSWORD="<密码>" 后再执行 npm run test:e2e
VITE_E2E_PASSWORD=

# ── 可选：接口基地址 ──
# 默认走相对路径 /api/v1（由 vite 代理或 nginx 反代），一般无需设置
# VITE_API_BASE=/api
